  "segments": [
    {
      "seg_id": "N01",
      "text": "Imagine four thousand deadly pit vipers trapped on one tiny island\u2014hanging from the trees at eye level.",
      "rate": "-4%",
      "pitch": "-1Hz",
      "start": 0.1,
      "end": 5.894,
      "duration": 5.794,
      "pause_after": 0.42,
      "emphasis_words": [
        "four",
        "thousand",
        "deadly",
        "vipers",
        "eye",
        "level"
      ]
    },
    {
      "seg_id": "N02",
      "text": "Thirty-three kilometers off Brazil sits Ilha da Queimada Grande\u2014a steep island completely overrun by venomous snakes. The danger is so extreme that Brazil's Navy banned unauthorized civilians from ever stepping ashore.",
      "rate": "+2%",
      "pitch": "-2Hz",
      "start": 6.314,
      "end": 18.585,
      "duration": 12.271,
      "pause_after": 0.42,
      "emphasis_words": [
        "Brazil",
        "Queimada",
        "Grande",
        "overrun",
        "banned",
        "civilians"
      ]
    },
    {
      "seg_id": "N03",
      "text": "Viral myths claim five snakes wait on every square meter. Butantan Institute surveys show no evidence of that rumor\u2014yet still count up to ninety deadly vipers per hectare. Walk just one hundred meters through this forest, and dozens of camouflaged vipers surround you.",
      "rate": "-1%",
      "pitch": "-2Hz",
      "start": 19.005,
      "end": 34.814,
      "duration": 15.809,
      "pause_after": 0.44,
      "emphasis_words": [
        "five",
        "snakes",
        "no",
        "evidence",
        "ninety",
        "deadly",
        "dozens",
        "vipers"
      ]
    },
    {
      "seg_id": "N04",
      "text": "Even worse, they don't just slither underfoot. In this silent forest, danger hangs directly above your head.",
      "rate": "-4%",
      "pitch": "+0Hz",
      "start": 35.254,
      "end": 41.664,
      "duration": 6.411,
      "pause_after": 0.42,
      "emphasis_words": [
        "worse",
        "don't",
        "slither",
        "underfoot",
        "above",
        "head"
      ]
    },
    {
      "seg_id": "N05",
      "text": "Trapped by rising seas eleven thousand years ago without mammals, thousands of vipers climbed into the trees. Today they hang coiled at neck height along dense branches, waiting to ambush landing birds.",
      "rate": "+0%",
      "pitch": "-1Hz",
      "start": 42.084,
      "end": 53.547,
      "duration": 11.463,
      "pause_after": 0.44,
      "emphasis_words": [
        "eleven",
        "thousand",
        "climbed",
        "trees",
        "neck",
        "height",
        "ambush",
        "birds"
      ]
    },
    {
      "seg_id": "N06",
      "text": "To stop bitten prey from flying out to sea, they evolved venom up to five times more potent. A single strike melts flesh in seconds\u2014dropping birds straight onto the forest floor.",
      "rate": "+0%",
      "pitch": "-1Hz",
      "start": 53.987,
      "end": 64.144,
      "duration": 10.157,
      "pause_after": 0.44,
      "emphasis_words": [
        "five",
        "times",
        "more",
        "potent",
        "melts",
        "flesh",
        "seconds"
      ]
    },
    {
      "seg_id": "N07",
      "text": "Humans staffed a lighthouse here in 1909\u2014before automating the tower and abandoning the forest to four thousand vipers.",
      "rate": "-5%",
      "pitch": "-2Hz",
      "start": 64.584,
      "end": 71.795,
      "duration": 7.21,
      "pause_after": 0.24,
      "emphasis_words": [
        "lighthouse",
        "1909",
        "automating",
        "abandoning",
        "four",
        "thousand",
        "vipers"
      ]
    }
  ],
