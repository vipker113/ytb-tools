  "pronunciation_sig": "{\"pron\": {\"Ijen\": \"Eejen\", \"Kawah\": \"Kahwah\", \"Naica\": \"Nyekah\"}, \"segs\": [[\"N01\", \"None of these three places on Earth are CGI. The last one drowns human lungs from the inside.\", null, \"+3%\", \"+0Hz\", 0.24], [\"N02\", \"At midnight in Indonesia, Kawah Ijen volcano appears to pour rivers of electric-blue lava. Except lava is never blue.\", null, \"+2%\", \"+0Hz\", 0.26], [\"N03\", \"Pressurized sulfur gas shoots from cracks at six hundred degrees Celsius and ignites on contact with air. Some gas condenses into liquid sulfur that keeps burning bright blue as it flows downhill.\", null, \"+1%\", \"+0Hz\", 0.26], [\"N04\", \"Cross into Ethiopia's Danakil Depression, and Earth stops looking habitable altogether. At Dallol, shallow volcanic heat boils groundwater packed with iron salts and sulfuric acid.\", null, \"+2%\", \"+1Hz\", 0.26], [\"N05\", \"Those neon-green pools drop below zero pH into negative acidity. Even with liquid water everywhere, biologists found zero active microbial life inside the ponds.\", null, \"+1%\", \"+0Hz\", 0.28], [\"N06\", \"Three hundred meters beneath Naica, Mexico lies an even stranger trap: the Cave of the Crystals. Mineral-rich hot water slowly grew gypsum beams eleven meters long and weighing fifty-five tons.\", null, \"+2%\", \"+1Hz\", 0.28], [\"N07\", \"Inside, fifty-eight-degree heat meets ninety-five percent humidity\\u2014hotter than your own lungs. Without ice suits and chilled air packs, every breath condenses water straight into your airways. That doesn't mean these places break physics\\u2014extreme heat and acid simply push chemistry past human limits.\", null, \"-1%\", \"-1Hz\", 0.26], [\"N08\", \"In twenty seventeen, groundwater flooded the Naica crystal cave shut forever\\u2014leaving three real worlds on Earth that look completely impossible.\", null, \"-1%\", \"-1Hz\", 0.24]]}",
  "total_duration_s": 85.9,
  "total_frames_30fps": 2577,
  "segments": [
    {
      "seg_id": "N01",
      "text": "None of these three places on Earth are CGI. The last one drowns human lungs from the inside.",
      "rate": "+3%",
      "pitch": "+0Hz",
      "start": 0.1,
      "end": 6.086,
      "duration": 5.986,
      "pause_after": 0.24,
      "emphasis_words": [
        "three",
        "CGI",
        "drowns",
        "lungs"
      ]
    },
    {
      "seg_id": "N02",
      "text": "At midnight in Indonesia, Kawah Ijen volcano appears to pour rivers of electric-blue lava. Except lava is never blue.",
      "rate": "+2%",
      "pitch": "+0Hz",
      "start": 6.326,
      "end": 14.021,
      "duration": 7.695,
      "pause_after": 0.26,
      "emphasis_words": [
        "Kawah",
        "Ijen",
        "electric-blue",
        "never",
        "blue"
      ]
    },
    {
      "seg_id": "N03",
      "text": "Pressurized sulfur gas shoots from cracks at six hundred degrees Celsius and ignites on contact with air. Some gas condenses into liquid sulfur that keeps burning bright blue as it flows downhill.",
      "rate": "+1%",
      "pitch": "+0Hz",
      "start": 14.281,
      "end": 25.249,
      "duration": 10.968,
      "pause_after": 0.26,
      "emphasis_words": [
        "six",
        "hundred",
        "Celsius",
        "liquid",
        "sulfur",
        "blue"
      ]
    },
    {
      "seg_id": "N04",
      "text": "Cross into Ethiopia's Danakil Depression, and Earth stops looking habitable altogether. At Dallol, shallow volcanic heat boils groundwater packed with iron salts and sulfuric acid.",
      "rate": "+2%",
      "pitch": "+1Hz",
      "start": 25.509,
      "end": 36.209,
      "duration": 10.699,
      "pause_after": 0.26,
      "emphasis_words": [
        "Danakil",
        "habitable",
        "Dallol",
        "sulfuric",
        "acid"
      ]
    },
    {
      "seg_id": "N05",
      "text": "Those neon-green pools drop below zero pH into negative acidity. Even with liquid water everywhere, biologists found zero active microbial life inside the ponds.",
      "rate": "+1%",
      "pitch": "+0Hz",
      "start": 36.469,
      "end": 46.875,
      "duration": 10.406,
      "pause_after": 0.28,
      "emphasis_words": [
        "zero",
        "pH",
        "negative",
        "microbial",
        "life"
      ]
    },
    {
      "seg_id": "N06",
      "text": "Three hundred meters beneath Naica, Mexico lies an even stranger trap: the Cave of the Crystals. Mineral-rich hot water slowly grew gypsum beams eleven meters long and weighing fifty-five tons.",
      "rate": "+2%",
      "pitch": "+1Hz",
      "start": 47.155,
      "end": 59.043,
      "duration": 11.888,
      "pause_after": 0.28,
      "emphasis_words": [
        "Three",
        "hundred",
        "Naica",
        "Crystals",
        "eleven",
        "meters",
        "fifty-five",
        "tons"
      ]
    },
    {
      "seg_id": "N07",
      "text": "Inside, fifty-eight-degree heat meets ninety-five percent humidity\u2014hotter than your own lungs. Without ice suits and chilled air packs, every breath condenses water straight into your airways. That doesn't mean these places break physics\u2014extreme heat and acid simply push chemistry past human limits.",
      "rate": "-1%",
      "pitch": "-1Hz",
      "start": 59.323,
      "end": 77.764,
      "duration": 18.441,
      "pause_after": 0.26,
      "emphasis_words": [
        "fifty-eight-degree",
        "ninety-five",
        "hotter",
        "lungs",
        "condenses",
        "limits"
      ]
    },
    {
      "seg_id": "N08",
      "text": "In twenty seventeen, groundwater flooded the Naica crystal cave shut forever\u2014leaving three real worlds on Earth that look completely impossible.",
      "rate": "-1%",
      "pitch": "-1Hz",
      "start": 78.024,
      "end": 85.664,
      "duration": 7.641,
      "pause_after": 0.24,
      "emphasis_words": [
        "flooded",
        "forever",
        "three",
        "impossible"
      ]
    }
  ],
