  "segments": [
    {
      "seg_id": "N01",
      "text": "You were taught that space is completely silent\u2014until NASA captured the real sound of a black hole.",
      "rate": "-4%",
      "pitch": "-1Hz",
      "start": 0.1,
      "end": 5.44,
      "duration": 5.34,
      "pause_after": 0.42,
      "emphasis_words": [
        "completely",
        "silent",
        "NASA",
        "real",
        "sound",
        "black",
        "hole"
      ]
    },
    {
      "seg_id": "N02",
      "text": "Two hundred fifty million light-years away sits the Perseus galaxy cluster. While empty space is a silent vacuum, this giant cluster is wrapped in superheated plasma spanning hundreds of thousands of light-years.",
      "rate": "+0%",
      "pitch": "-2Hz",
      "start": 5.86,
      "end": 17.243,
      "duration": 11.383,
      "pause_after": 0.42,
      "emphasis_words": [
        "Two",
        "hundred",
        "fifty",
        "Perseus",
        "silent",
        "vacuum",
        "superheated",
        "plasma"
      ]
    },
    {
      "seg_id": "N03",
      "text": "In 2003, astronomers studying NASA's Chandra X-ray images noticed giant concentric ripples rolling through that gas. Relativistic jets blasting from the central black hole were inflating enormous cavities\u2014pushing true sound waves outward.",
      "rate": "+0%",
      "pitch": "-2Hz",
      "start": 17.663,
      "end": 31.734,
      "duration": 14.071,
      "pause_after": 0.42,
      "emphasis_words": [
        "2003",
        "Chandra",
        "concentric",
        "ripples",
        "Relativistic",
        "jets",
        "true",
        "sound"
      ]
    },
    {
      "seg_id": "N04",
      "text": "The pitch hit a deep B-flat fifty-seven octaves below middle C. Each oscillation takes nearly ten million years\u2014one hundred forty-four quadrillion times deeper than human ears can detect.",
      "rate": "-4%",
      "pitch": "+0Hz",
      "start": 32.154,
      "end": 43.402,
      "duration": 11.248,
      "pause_after": 0.44,
      "emphasis_words": [
        "B-flat",
        "fifty-seven",
        "octaves",
        "ten",
        "million",
        "quadrillion",
        "deeper"
      ]
    },
    {
      "seg_id": "N05",
      "text": "Telescopes show no evidence of sound traveling through empty vacuum. Instead, NASA extracted Chandra's real X-ray pressure ripples and scaled them up fifty-seven octaves\u2014revealing this haunting cosmic roar.",
      "rate": "-1%",
      "pitch": "-1Hz",
      "start": 43.842,
      "end": 55.526,
      "duration": 11.684,
      "pause_after": 0.94,
      "emphasis_words": [
        "no",
        "evidence",
        "empty",
        "vacuum",
        "real",
        "scaled",
        "haunting",
        "roar"
      ]
    },
    {
      "seg_id": "N06",
      "text": "Those acoustic waves carry colossal energy across the cluster, heating the surrounding gas for billions of years so trillions of stars cannot chaotically collapse.",
      "rate": "+2%",
      "pitch": "-1Hz",
      "start": 56.466,
      "end": 64.415,
      "duration": 7.949,
      "pause_after": 0.42,
      "emphasis_words": [
        "colossal",
        "energy",
        "heating",
        "billions",
        "trillions",
        "collapse"
      ]
    },
    {
      "seg_id": "N07",
      "text": "The universe isn't silent after all\u2014we simply needed an X-ray telescope to hear its deepest note.",
      "rate": "-5%",
      "pitch": "-2Hz",
      "start": 64.835,
      "end": 70.378,
      "duration": 5.543,
      "pause_after": 0.24,
      "emphasis_words": [
        "universe",
        "isn't",
        "silent",
        "X-ray",
        "deepest",
        "note"
      ]
    }
  ],
