      ]
    },
    {
      "seg_id": "N02",
      "text": "Launched atop a Delta IV Heavy rocket, Parker Solar Probe plunged within three point eight million miles of the Sun. Its onboard camera filmed glowing plasma streamers rushing directly past the spacecraft.",
      "delivery": "MEASURED_EVIDENCE",
      "rate": "-1%",
      "pitch": "-1Hz",
      "start": 5.755,
      "end": 16.932,
