!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local persistent database (contains personal API keys & channel snapshots)
/data/
/public/generated-videos/
/public/ki-challenge/custom/
/public/ki-challenge/custom-audio/
/mac-setup-package/
__pycache__/
*.pyc

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python virtualenvs & third-party local MCP clones
.venv*/
mcp-servers/

