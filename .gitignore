*.swp

# Python caches & virtual environments
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.uv-cache/
.uv-python/

# Secrets & local user databases (NEVER commit OAuth/API keys)
.env
.env.*
*.pem
*client_secret*.json

# Third-party legacy repo (Studio v6 is self-contained inside youtube-shorts-channel)
MoneyPrinterTurbo/

# Heavy ML checkpoints & raw footage (>10 GB; auto-downloaded or fetched per episode)
youtube-shorts-channel/assets/models/
youtube-shorts-channel/assets/raw_footage/

