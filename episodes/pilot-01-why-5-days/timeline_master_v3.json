      "index": 131,
      "start": 266.5,
      "end": 269.7,
      "dur": 3.2,
      "sub": "would destroy the moral fabric of America.",
      "spec": "scene:103_us_steel_moral_collapse_podium.png"
    },
    {
      "index": 132,
      "start": 269.7,
      "end": 271.76,
      "dur": 2.06,
      "sub": "Wait, stop right there.",
