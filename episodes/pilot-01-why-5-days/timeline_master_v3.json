      "index": 136,
      "start": 279.08,
      "end": 281.74,
      "dur": 2.66,
      "sub": "to make sure they were not slacking off.",
      "spec": "scene:46_sociological_spy.png+closeup:680,460,1.35"
    },
    {
      "index": 137,
      "start": 281.74,
      "end": 285.78,
      "dur": 4.04,
      "sub": "He did not give away millions of hours of labor out of kindness.",
      "spec": "scene:102_ford_angel_halo_disguise.png+x_on:1180,380,220"
    },
    {
      "index": 138,
      "start": 285.78,
      "end": 287.34,
      "dur": 1.56,
      "sub": "He had discovered a fatal math",
      "spec": "scene:105_ford_chalkboard_fatal_math.png"
    },
    {
      "index": 139,
      "start": 287.34,
      "end": 289.92,
      "dur": 2.58,
      "sub": "problem at the heart of capitalism.",
      "spec": "scene:105_ford_chalkboard_fatal_math.png+closeup:1140,390,1.35"
    },
    {
      "index": 140,
      "start": 289.92,
      "end": 293.48,
      "dur": 3.56,
      "sub": "By the mid-1920s, Ford's assembly lines were churning out",
      "spec": "scene:21_ford_1926_assembly_line.png+closeup:860,520,1.32"
