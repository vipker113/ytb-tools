      "index": 175,
      "start": 382.3,
      "end": 385.1,
      "dur": 2.8,
      "sub": "a bill introduced by Senator Hugo Black.",
      "spec": "scene:06_senate_1933_30hr_gavel.png"
    },
    {
      "index": 176,
      "start": 385.1,
      "end": 389.62,
      "dur": 4.52,
      "sub": "The bill made it illegal for any factory or business to employ someone for more than",
      "spec": "scene:119_factory_30hr_speed_limit_sign.png"
    },
    {
      "index": 177,
      "start": 389.62,
      "end": 390.78,
      "dur": 1.16,
      "sub": "30 hours a week,",
      "spec": "scene:119_factory_30hr_speed_limit_sign.png+closeup:760,520,1.35"
    },
    {
      "index": 178,
      "start": 390.78,
      "end": 393.68,
      "dur": 2.9,
      "sub": "six hours a day, five days a week.",
      "spec": "scene:06_senate_1933_30hr_gavel.png+closeup:960,480,1.32"
    },
    {
      "index": 179,
      "start": 393.68,
      "end": 395.42,
      "dur": 1.74,
      "sub": "And it passed the U .S. Senate,",
      "spec": "scene:120_senate_scoreboard_53_to_30.png"
    },
    {
      "index": 180,
      "start": 395.42,
      "end": 397.56,
      "dur": 2.14,
      "sub": "53 to 30.",
      "spec": "scene:120_senate_scoreboard_53_to_30.png+closeup:960,360,1.38"
    },
    {
      "index": 181,
      "start": 397.56,
      "end": 399.78,
      "dur": 2.22,
      "sub": "Kellogg's even switched its battle creek plant to",
      "spec": "scene:51_kellogg_6hr_shift.png"
    },
    {
      "index": 182,
      "start": 399.78,
      "end": 402.58,
      "dur": 2.8,
      "sub": "six -hour shifts and found that accidents dropped,",
      "spec": "scene:121_kellogg_cereal_box_safety_chart.png"
    },
    {
      "index": 183,
      "start": 402.58,
      "end": 403.61,
      "dur": 1.03,
      "sub": "efficiency rose,",
      "spec": "scene:121_kellogg_cereal_box_safety_chart.png+closeup:1180,340,1.35"
    },
    {
      "index": 184,
      "start": 403.61,
      "end": 406.72,
      "dur": 3.11,
      "sub": "and workers had the entire afternoon free.",
      "spec": "scene:26_kellogg_2pm_park_family.png"
    },
    {
      "index": 185,
      "start": 406.72,
      "end": 408.79,
      "dur": 2.07,
      "sub": "For a few months in 1933,",
      "spec": "scene:122_1933_6hr_law_finish_line_tape.png"
    },
    {
      "index": 186,
      "start": 408.79,
      "end": 413.12,
      "dur": 4.33,
      "sub": "the six -hour workday was on the verge of becoming the law of the land.",
      "spec": "scene:122_1933_6hr_law_finish_line_tape.png+closeup:1120,480,1.32"
    },
