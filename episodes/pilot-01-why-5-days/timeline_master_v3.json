    },
    {
      "index": 121,
      "start": 240.8,
      "end": 242.98,
      "dur": 2.18,
      "sub": "free from that six -day cage?",
      "spec": "scene:100_saturday_breaking_chains.png+closeup:960,480,1.32"
    },
    {
      "index": 122,
      "start": 242.98,
      "end": 246.98,
      "dur": 4.0,
      "sub": "Most textbooks give the credit to one man, Henry Ford.",
      "spec": "scene:21_ford_1926_assembly_line.png"
    },
    {
      "index": 123,
      "start": 246.98,
      "end": 249.78,
      "dur": 2.8,
      "sub": "On September 25th, 1926,",
      "spec": "scene:101_sept_25_1926_newspaper_flash.png+closeup:960,440,1.35"
    },
    {
      "index": 124,
      "start": 249.78,
      "end": 252.7,
      "dur": 2.92,
      "sub": "Ford stunned the business world by announcing that his workers",
      "spec": "scene:101_sept_25_1926_newspaper_flash.png"
    },
    {
      "index": 125,
      "start": 252.7,
      "end": 255.28,
      "dur": 2.58,
      "sub": "would now work only five days a week,",
      "spec": "scene:101_sept_25_1926_newspaper_flash.png+bubble:960,150,ONLY 5 DAYS A WEEK!"
    },
    {
      "index": 126,
      "start": 255.28,
      "end": 256.34,
      "dur": 1.06,
      "sub": "Monday through Friday,",
      "spec": "scene:45_six_dollar_envelope.png"
    },
    {
      "index": 127,
      "start": 256.34,
      "end": 259.1,
      "dur": 2.76,
      "sub": "for the same six -dollar daily pay.",
      "spec": "scene:45_six_dollar_envelope.png+check_on:1620,220"
    },
    {
      "index": 128,
      "start": 259.1,
      "end": 262.8,
      "dur": 3.7,
      "sub": "On the surface, it looked like extraordinary generosity.",
      "spec": "scene:102_ford_angel_halo_disguise.png"
    },
    {
      "index": 129,
      "start": 262.8,
      "end": 264.32,
      "dur": 1.52,
      "sub": "The head of U .S. Steel warned",
      "spec": "scene:22_steel_boss_angry_5days.png"
    },
    {
      "index": 130,
      "start": 264.32,
      "end": 266.5,
      "dur": 2.18,
      "sub": "that giving workers two whole days off",
      "spec": "scene:103_us_steel_moral_collapse_podium.png+reveal_left:1180"
    },
