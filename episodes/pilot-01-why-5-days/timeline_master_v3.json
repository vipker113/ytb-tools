    {
      "index": 141,
      "start": 293.48,
      "end": 296.02,
      "dur": 2.54,
      "sub": "Model T cars faster than ever.",
      "spec": "scene:106_overflowing_model_t_parking_lot.png"
    },
    {
      "index": 142,
      "start": 296.02,
      "end": 298.58,
      "dur": 2.56,
      "sub": "His workers even earned enough to afford one.",
      "spec": "scene:107_worker_piggybank_car_price.png+reveal_left:780"
    },
    {
      "index": 143,
      "start": 298.58,
      "end": 300.64,
      "dur": 2.06,
      "sub": "There was just one catch.",
      "spec": "host:01_pose_explaining.png"
    },
    {
      "index": 144,
      "start": 300.64,
      "end": 302.04,
      "dur": 1.4,
      "sub": "Why would a man buy a family",
      "spec": "scene:107_worker_piggybank_car_price.png"
    },
    {
      "index": 145,
      "start": 302.04,
      "end": 303.96,
      "dur": 1.92,
      "sub": "car if he worked six days a week,",
      "spec": "scene:23_exhausted_worker_bed_model_t.png"
    },
    {
      "index": 146,
      "start": 303.96,
      "end": 306.12,
      "dur": 2.16,
      "sub": "collapsed into bed on Saturday night,",
      "spec": "scene:23_exhausted_worker_bed_model_t.png+closeup:640,620,1.35"
    },
