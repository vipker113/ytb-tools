      "index": 150,
      "start": 313.46,
      "end": 317.62,
      "dur": 4.16,
      "sub": "Listen to what Henry Ford told World's Work magazine in 1926,",
      "spec": "scene:109_ford_interview_magazine_mic.png"
    },
