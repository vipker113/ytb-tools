    },
    {
      "index": 133,
      "start": 271.76,
      "end": 273.02,
      "dur": 1.26,
      "sub": "Henry Ford was one of the",
      "spec": "scene:104_ford_stopwatch_whip_assembly.png"
    },
    {
      "index": 134,
      "start": 273.02,
      "end": 275.68,
      "dur": 2.66,
      "sub": "most ruthless efficiency obsessives in history.",
      "spec": "scene:104_ford_stopwatch_whip_assembly.png+closeup:1240,560,1.35"
    },
    {
      "index": 135,
      "start": 275.68,
      "end": 279.08,
      "dur": 3.4,
      "sub": "He had a private security force that spied on his workers",
      "spec": "scene:46_sociological_spy.png"
    },
