    {
      "index": 21,
      "start": 28.58,
      "end": 31.14,
      "dur": 2.56,
      "sub": "Most of us treat it like a law of nature,",
      "spec": "scene:11_ref_sunday_tv_calendar.png"
    },
    {
      "index": 22,
      "start": 31.14,
      "end": 32.38,
      "dur": 1.24,
      "sub": "like seven days in a week",
      "spec": "scene:73_earth_sun_moon_24h_cycle.png+reveal_left:1280"
    },
    {
      "index": 23,
      "start": 32.38,
      "end": 34.68,
      "dur": 2.3,
      "sub": "or 24 hours in a day.",
      "spec": "scene:73_earth_sun_moon_24h_cycle.png"
    },
    {
      "index": 24,
      "start": 34.68,
      "end": 37.08,
      "dur": 2.4,
      "sub": "And if you ask people why we do it this way,",
      "spec": "scene:74_street_interview_mic_story.png+closeup:580,520,1.35"
    },
    {
      "index": 25,
      "start": 37.08,
      "end": 39.38,
      "dur": 2.3,
      "sub": "they usually tell you the same story.",
      "spec": "scene:74_street_interview_mic_story.png"
    },
    {
      "index": 26,
      "start": 39.38,
      "end": 42.8,
      "dur": 3.42,
      "sub": "They say life used to be an endless, brutal grind",
      "spec": "scene:75_caveman_boulder_sunrise_sunset.png"
    },
    {
      "index": 27,
      "start": 42.8,
      "end": 44.12,
      "dur": 1.32,
      "sub": "that our ancestors worked from",
      "spec": "scene:14_ancient_sunrise_hill_stretch.png"
    },
    {
      "index": 28,
      "start": 44.12,
      "end": 46.16,
      "dur": 2.04,
      "sub": "sunrise to sunset every day",
      "spec": "scene:75_caveman_boulder_sunrise_sunset.png+closeup:620,620,1.35"
    },
    {
      "index": 29,
      "start": 46.16,
      "end": 47.52,
      "dur": 1.36,
      "sub": "just to survive,",
      "spec": "scene:75_caveman_boulder_sunrise_sunset.png+bubble:580,260,JUST TO SURVIVE!"
    },
    {
      "index": 30,
      "start": 47.52,
      "end": 48.58,
      "dur": 1.06,
      "sub": "and that the five -day work",
      "spec": "scene:76_official_story_textbook_podium.png"
    },
    {
      "index": 31,
      "start": 48.58,
      "end": 51.56,
      "dur": 2.98,
      "sub": "week is the pinnacle of modern progress.",
      "spec": "scene:76_official_story_textbook_podium.png+closeup:1320,560,1.38"
    },
    {
      "index": 32,
      "start": 51.56,
      "end": 53.96,
      "dur": 2.4,
      "sub": "That is the official story.",
      "spec": "scene:76_official_story_textbook_podium.png+check_on:1680,220"
    },
    {
      "index": 33,
      "start": 53.96,
      "end": 56.54,
      "dur": 2.58,
      "sub": "There is just one problem with it.",
      "spec": "host:05_pose_pointing_aha.png"
    },
    {
      "index": 34,
      "start": 56.54,
      "end": 58.5,
      "dur": 1.96,
      "sub": "When historians opened the tax ledgers,",
      "spec": "scene:15_harvard_150_days_ledger.png"
    },
    {
      "index": 35,
      "start": 58.5,
      "end": 60.4,
      "dur": 1.9,
